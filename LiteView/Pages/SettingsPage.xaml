<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteView.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteView.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock x:Uid="Settings"
            x:Name="PageHeader"
            MaxWidth="1064"
            Margin="36,40,36,0"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}" />
        
        <!-- 内容 -->
        <ScrollView
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Orientation="Vertical"
                        MaxWidth="1024"
                        Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" x:Uid="Appearance"/>
                <controls:SettingsCard x:Uid="Theme">
                    <ComboBox x:Name="themeMode" 
                              MinWidth="200"
                              SelectionChangedTrigger="Committed"
                              SelectionChanged="themeMode_SelectionChanged"
                              SelectedIndex="{x:Bind ViewModel.ThemeMode, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="ThemeUsingSystemSetting" Tag="Default" />
                        <ComboBoxItem x:Uid="ThemeLight" Tag="Light" />
                        <ComboBoxItem x:Uid="ThemeDark" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" x:Uid="About" />
                <controls:SettingsExpander Description="© 2026 Devode."
                                           Header="LiteView">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="CheckForUpdate" VerticalAlignment="Center" Command="{x:Bind ViewModel.CheckUpdateCommand}"/>

                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.CurrentVersion, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="/Assets/Icons/LiteViewIcon.ico" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="Repository">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/Devode/LiteView-Windows" />
                                <HyperlinkButton Content="Gitee" NavigateUri="https://gitee.com/devode/LiteView-Windows" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                
            </StackPanel>
        </ScrollView>
        <StackPanel Grid.Row="2"
                    Margin="36,0,36,2"
                    Spacing="8">
            <InfoBar
                x:Uid="NoUpdate"
                IsOpen="{x:Bind ViewModel.IsNoUpdateInfoOpen, Mode=TwoWay}"
                Severity="Informational" />
            <InfoBar
                x:Uid="NetworkError"
                IsOpen="{x:Bind ViewModel.IsNetworkErrorInfoOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NetworkErrorInfo, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>
    </Grid>
</Page>
