<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteView.Pages.PdfViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteView.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:control="using:LiteView.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 极简工具栏按钮样式 -->
        <Style x:Key="ToolbarButtonStyle" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="{x:Bind AplyButtonZoom(ButtonZoom), Mode=OneWay}"/> <!-- 原 48 -->
            <Setter Property="Height" Value="{x:Bind AplyButtonZoom(ButtonZoom), Mode=OneWay}"/> <!-- 原 48 -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Content="{TemplateBinding Content}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            CornerRadius="{TemplateBinding CornerRadius}">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
                                                <!-- 悬停变灰 -->
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"/>
                                                <!-- 按下更深 -->
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                                <!-- 按下内容变色 -->
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppBarBackgroundThemeBrush}"/>
                                                <!-- 背景变色 -->
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                                <!-- 内容变色 -->
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="PdfGrid">
        <control:PdfViewerControl x:Name="PdfViewer"
                                  SimplifiedTolerance="{x:Bind StrokeSimplifiedTolerance, Mode=OneWay}"/>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20" CornerRadius="20"
                Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderThickness="1"
                Translation="0,0,16">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            
            <Button x:Uid="Toolbar_Menu"
                    Padding="16,8" CornerRadius="20"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Style="{StaticResource ToolbarButtonStyle}">

                <Button.Content>
                    <FontIcon Glyph="&#xE700;" FontSize="24" />
                </Button.Content>

                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="进入全屏" Tag="EnterFullScreen" Click="OptionFullScreen_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE740;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>

            </Button>
        </Border>
        

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" CornerRadius="20"
                Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderThickness="1"
                Translation="0,0,16">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Button x:Name="PreviousPageBtn" Click="PreviousPageBtn_Click"
                        Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE76B;" FontSize="24" />
                </Button>
                <Button x:Name="PageBtn" x:Uid="ToolBar_PageBtn" Click="PageBtn_Click"
                        Padding="8" Width="Auto" Style="{StaticResource ToolbarButtonStyle}">
                    <TextBlock>
                        <Run x:Uid="PageNumber" />
                        <!-- 显示当前页面页码，由代码控制文本 -->
                        <Run x:Name="CurrentPageText" />
                        <Run Text="/" />
                        <Run x:Name="TotalPageText" />
                    </TextBlock>
                </Button>
                <Button x:Name="NextPageBtn" Click="NextPageBtn_Click"
                        Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE76C;" FontSize="24" />
                </Button>
            </StackPanel>
        </Border>

        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Border Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" CornerRadius="20" Padding="8,4" BorderThickness="1" BorderBrush="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    Translation="0,0,16">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                
                <StackPanel Orientation="Horizontal" Spacing="4">

                    <!-- 左侧工具组 -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton x:Name="BtnSelect" x:Uid="Toolbar_Select" Click="ToolButton_Click" IsChecked="True"
                                      Style="{StaticResource ToolbarButtonStyle}">
                            <!-- 鼠标指针 -->
                            <FontIcon Glyph="&#xE8B0;" FontSize="{x:Bind ButtonZoom, Mode=OneWay}"/> <!-- 原FontSize = 14 -->
                        </ToggleButton>
                        <ToggleButton x:Name="BtnPen" x:Uid="Toolbar_Pen" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarButtonStyle}">
                            <!-- 铅笔 -->
                            <FontIcon Glyph="&#xE70F;" FontSize="{x:Bind ButtonZoom, Mode=OneWay}"/>

                            <!-- 画笔设置 -->
                            <FlyoutBase.AttachedFlyout>
                                <Flyout>
                                    <StackPanel MinWidth="200" Spacing="12">
                                        <Slider x:Name="StrokeThicknessSlider" x:Uid="StrokeThickness" 
                                                Minimum="0.1" Maximum="24" StepFrequency="0.1" 
                                                ValueChanged="StrokeThicknessSlider_ValueChanged" 
                                                Value="{x:Bind StrokeThickness, Mode=TwoWay}" />

                                        <StackPanel Orientation="Vertical" Spacing="12">
                                            <TextBlock x:Uid="PenColor"/>
                                            <SplitButton x:Name="PickColorBtn">
                                                <Border x:Name="CurrentColor" Width="32" Height="32" Background="{x:Bind ToBrush(PenColor), Mode=OneWay}" CornerRadius="4,0,0,4"/>
                                                <SplitButton.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <ColorPicker x:Name="PenColorPicker" Color="Red" ColorChanged="PenColorPicker_ColorChanged" />
                                                    </Flyout>
                                                </SplitButton.Flyout>
                                            </SplitButton>
                                        </StackPanel>

                                    </StackPanel>
                                    
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnEraser" x:Uid="Toolbar_Eraser" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarButtonStyle}">
                            <!-- 橡皮 -->
                            <FontIcon Glyph="&#xED60;" FontSize="{x:Bind ButtonZoom, Mode=OneWay}"/>
                        </ToggleButton>
                        <Button x:Name="BtnClear" x:Uid="Toolbar_Clear" Click="BtnClear_Click"
                                Style="{StaticResource ToolbarButtonStyle}">
                            <!-- 垃圾桶 -->
                            <FontIcon Glyph="&#xE74D;" FontSize="{x:Bind ButtonZoom, Mode=OneWay}"/>
                        </Button>
                    </StackPanel>

                    <!-- 分割线 -->
                    <Rectangle Width="1" Fill="#DDDDDD" Margin="4,4"/>

                    <!-- 右侧工具组 -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="FitToWindow" x:Uid="Toolbar_FitToWindow" Click="FitToWindow_Click"
                                Style="{StaticResource ToolbarButtonStyle}">
                            <FontIcon Glyph="&#xE740;" FontSize="{x:Bind ButtonZoom, Mode=OneWay}"/>
                        </Button>
                        <Button x:Name="ZoomInBtn" x:Uid="Toolbar_ZoomIn" Click="ZoomInBtn_Click"
                                Style="{StaticResource ToolbarButtonStyle}">
                            <FontIcon Glyph="&#xE8A3;" FontSize="{x:Bind ButtonZoom, Mode=OneWay}"/>
                        </Button>
                        <Button x:Name="ZoomOutBtn" x:Uid="Toolbar_ZoomOut" Click="ZoomOutBtn_Click"
                                Style="{StaticResource ToolbarButtonStyle}">
                            <FontIcon Glyph="&#xE71F;" FontSize="{x:Bind ButtonZoom, Mode=OneWay}"/>
                        </Button>
                        <Button x:Name="SettingsBtn" x:Uid="Toolbar_Settings" Style="{StaticResource ToolbarButtonStyle}">
                            <FontIcon Glyph="&#xE713;" FontSize="{x:Bind ButtonZoom, Mode=OneWay}"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="12" MinWidth="200">
                                        <Slider x:Uid="ToolBarZoom" Minimum="8" Maximum="64" StepFrequency="0.1" Value="{x:Bind ButtonZoom, Mode=TwoWay}" />

                                        <!-- <Slider x:Name="StrokeThicknessSlider" x:Uid="StrokeThickness" Minimum="0.1" Maximum="24" StepFrequency="0.1" ValueChanged="StrokeThicknessSlider_ValueChanged" Value="{x:Bind StrokeThickness, Mode=TwoWay}" /> -->

                                        <!-- <StackPanel Orientation="Vertical" Spacing="12">
                                            <TextBlock x:Uid="PenColor"/>
                                            <SplitButton x:Name="PickColorBtn">
                                                <Border x:Name="CurrentColor" Width="32" Height="32" Background="{x:Bind ToBrush(PenColor), Mode=OneWay}" CornerRadius="4,0,0,4"/>
                                                <SplitButton.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <ColorPicker x:Name="PenColorPicker" Color="Red" ColorChanged="PenColorPicker_ColorChanged" />
                                                    </Flyout>
                                                </SplitButton.Flyout>
                                            </SplitButton>
                                        </StackPanel> -->
                                        
                                        <Button x:Uid="MoreOptions">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel Spacing="12" MinWidth="200">
                                                        <Slider x:Uid="StrokeSimplifiedTolerance" Minimum="0" Maximum="16" StepFrequency="0.1" Value="{x:Bind StrokeSimplifiedTolerance, Mode=TwoWay}" MinWidth="100"
                                                                VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <!-- 教程 -->
        <TeachingTip x:Name="WelcomeTip"
                     Title="欢迎使用 LiteView！"
                     Subtitle="这是您的首次启动，让我带您快速了解阅读器各工具的用法。"
                     IsOpen="False"
                     PreferredPlacement="Center">
            <TeachingTip.Content>
                <TextBlock Margin="0,16,0,0" Text="若您是第一次使用，请务必仔细观看教程。" />
            </TeachingTip.Content>
        </TeachingTip>

        <TeachingTip x:Name="SelectBtnTip"
                     Title="“选择”工具"
                     Subtitle="主要用于翻页（适用于触屏）"
                     IsOpen="False"
                     Target="{x:Bind BtnSelect}" />
        <TeachingTip x:Name="PenBtnTip"
                     Title="“画笔”工具"
                     Subtitle="主要用于批注、绘画等。选中后单击此按钮可打开笔迹设置"
                     IsOpen="False"
                     Target="{x:Bind BtnPen}" />
        <TeachingTip x:Name="EraserBtnTip"
                     Title="“橡皮”工具"
                     Subtitle="主要用于擦除“画笔”工具绘制的笔迹"
                     IsOpen="False"
                     Target="{x:Bind BtnEraser}" />
        <TeachingTip x:Name="ClearBtnTip"
                     Title="“清空”按钮"
                     Subtitle="用于翻清除所有的“画笔”工具绘制的笔迹"
                     IsOpen="False"
                     Target="{x:Bind BtnClear}" />
        
        <TeachingTip x:Name="FitToWindowBtnTip"
                     Title="“适应屏幕”按钮"
                     Subtitle="用于将页面缩放到适合窗口的大小"
                     IsOpen="False"
                     Target="{x:Bind FitToWindow}" />
        <TeachingTip x:Name="ZoomInBtnTip"
                     Title="“放大”按钮"
                     Subtitle="用于放大页面"
                     IsOpen="False"
                     Target="{x:Bind ZoomInBtn}" />
        <TeachingTip x:Name="ZoomOutBtnTip"
                     Title="“缩小”按钮"
                     Subtitle="用于缩小页面"
                     IsOpen="False"
                     Target="{x:Bind ZoomOutBtn}" />
        <TeachingTip x:Name="SettingsBtnTip"
                     Title="“设置”按钮"
                     Subtitle="用于配置阅读器的选项"
                     IsOpen="False"
                     Target="{x:Bind SettingsBtn}" />
        
        <TeachingTip x:Name="PageBtnTip"
                     Title="“页码”按钮"
                     Subtitle="用于显示当前页码，单击打开“跳转到指定页面”窗口"
                     IsOpen="False"
                     Target="{x:Bind PageBtn}" />
        
    </Grid>
</Page>
