<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteView.Pages.PdfListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiteView.Pages"
    xmlns:localModels="using:LiteView.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <ListView ItemsSource="{x:Bind PdfList, Mode=OneWay}"
                  SelectionMode="Single"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  Background="Transparent">
            
            <!-- 移除默认的ItemContainer样式间距 -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,4,0,4" /> <!-- 卡片之间的间距 -->
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="localModels:PdfItem">
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
