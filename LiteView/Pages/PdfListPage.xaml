<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiteView.Pages.PdfListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="using:LiteView.Styles"
    xmlns:localModels="using:LiteView.Models"
    xmlns:controls="using:LiteView.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <styles:PdfItemTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="20">
        <TextBlock Text="无 PDF 文件"
                   Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

        <ScrollView>
            <ListView ItemsSource="{x:Bind ViewModel.PdfItems, Mode=OneWay}"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      ItemClick="ListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="localModels:PdfItem">
                        <controls:PdfListItemControl Model="{Binding}" />
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,4,0,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter>
                                        <ContentPresenter.ContentTransitions>
                                            <TransitionCollection>
                                                <AddDeleteThemeTransition />
                                                <ContentThemeTransition />
                                            </TransitionCollection>
                                        </ContentPresenter.ContentTransitions>
                                    </ContentPresenter>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </ScrollView>
        <Button Command="{x:Bind ViewModel.AddPdfCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="64" Height="64" CornerRadius="8" Margin="16,16,16,16" Translation="0,0,16">
            <FontIcon Glyph="&#xE710;" />
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
        </Button>
    </Grid>
</Page>
